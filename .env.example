# =============================================================================
# Server-side backend infrastructure for form submissions.
#
# These variables are used ONLY by the Vercel serverless functions in /api.
# They must NEVER be prefixed with VITE_ and must NEVER be exposed to the
# browser. Do not commit real values — configure them in the Vercel dashboard
# (Project Settings -> Environment Variables).
# =============================================================================

# --- Resend (email notifications) --------------------------------------------
RESEND_API_KEY=
# Recipient of form-submission notifications (e.g. your team inbox).
FORM_NOTIFICATION_EMAIL=
# Verified Resend sender address (must be on a domain verified in Resend).
FORM_FROM_EMAIL=

# --- Supabase Storage (uploaded files/videos) --------------------------------
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are already provided by the
# connected Supabase integration. The service-role key is server-side ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Name of the Storage bucket that will hold uploads (defaults to "form-uploads").
SUPABASE_STORAGE_BUCKET=form-uploads
